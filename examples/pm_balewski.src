#!/bin/bash

source ~/.ssh/aqdrop_user.creds
env |grep AQDROP  # activate to see the creds

IMG=ubu24-aqdrop:p1c

CFSH=/global/cfs/cdirs/mpccc/balewski/

echo launch image $IMG
echo you are launching Podman-HPC image ...  remeber to exit

JNB_PORT=' '
BASE_DIR=/AQDrop   # here git has home
WORK_DIR=$BASE_DIR/examples
DATA_VAULT=/quantDataVault2026

echo "The number of arguments is: $#"
#  encoded variables:    jnb
for var in "$@"; do
  echo "The length of argument '$var' is: ${#var}"
  if [[ "jnb" ==  $var ]];  then
     JNB_PORT="    -p 8833:8833 "
     echo added  $JNB_PORT
     echo "  cd notebooks;  jupyter notebook --ip 0.0.0.0 --no-browser --allow-root --port  8833 "
  fi
  # ... more ...
done

eval podman-hpc run -it \
     -e SFAPI_TOKEN=$SFAPI_TOKEN \
     -e AQDROP_HOSTNAME=$AQDROP_HOSTNAME \
   --volume  $CFSH/myAQDrop/$BASE_DIR:$BASE_DIR \
    --volume $CFSH/${DATA_VAULT}:${DATA_VAULT} \
    -e DISPLAY  --net=host -v $HOME:$HOME -e HOME  \
   --workdir $WORK_DIR \
   $IMG /bin/bash
